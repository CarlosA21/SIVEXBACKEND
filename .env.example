# Copy to .env and replace these placeholders. Never commit actual credentials.
NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=sivex_user
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DB_NAME=sivex
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_TOKEN_EXPIRATION_TIME=2h
CORS_ORIGINS=http://localhost:5173
HOST_FRONTEND=http://localhost:5173
# For password recovery configure Gmail OAuth or SMTP only if used.
